# Copy to backend.tf AFTER creating and securing the bucket.
terraform {
  backend "s3" {
    bucket = "REPLACE_ME_STATE_BUCKET"
    key = "aws-gcp-ha-vpn/bootstrap/vault.tfstate"
    region = "REPLACE_ME_REGION"
    encrypt = true
    use_lockfile = true
    kms_key_id = "REPLACE_ME_KMS_KEY_ARN"
  }
}
